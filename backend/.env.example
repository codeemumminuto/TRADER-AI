# Chave gratuita da Twelve Data (https://twelvedata.com/pricing) - necessaria apenas para ativos forex
TWELVE_DATA_API_KEY=

# Origem do frontend, para CORS
CORS_ORIGIN=http://localhost:5174

# Banco (sobe com `docker compose up -d db` na raiz do repo)
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/trader_ai

# Sessao de login
SESSION_SECRET=change-me
SESSION_TTL_HOURS=12

# Bootstrap do primeiro admin - criado automaticamente no startup se nao existir nenhum admin
ADMIN_EMAIL=admin@trader-ai.local
ADMIN_PASSWORD=change-me
